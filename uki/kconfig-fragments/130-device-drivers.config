# Disable support for various non-applicanble hardware, and build in the drivers
# for hardware that is always a wipe target

# Microsoft Surface and Chromebook
CONFIG_SURFACE_PLATFORMS=n
CONFIG_CHROME_PLATFORMS=n

# Sound hardware
CONFIG_SND=n
CONFIG_SOUND=n
CONFIG_SOUNDWIRE=n

# Busses and interconnects
CONFIG_CAN=n
CONFIG_CAN_DEV=n
CONFIG_PCCARD=n
CONFIG_PCMCIA=n
CONFIG_YENTA=n
CONFIG_RAPIDIO=n
CONFIG_FIREWIRE=n

# Various media devices
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING_MEDIA=n

# Radios, Bluetooth, near field, amatuer band and packet radio, zigbee, etc
CONFIG_BT=n
CONFIG_NFC=n
CONFIG_RADIO_ADAPTERS=n
CONFIG_MEDIA_SDR_SUPPORT=n
CONFIG_HAMRADIO=n
CONFIG_RFKILL=n
CONFIG_IEEE802154_DRIVERS=n

# Infrared devices
CONFIG_RC_CORE=n

# Input devices
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MISC=n
CONFIG_INPUT_LEDS=n
CONFIG_GAMEPORT=n
CONFIG_ACCESSIBILITY=n

# USB devices
CONFIG_USB_NET_DRIVERS=n

# Display devices
CONFIG_DRM=n
CONFIG_VT=n
CONFIG_FB=n
CONFIG_SYSFB_SIMPLEFB=n

# Storage devices
CONFIG_ATA_SFF=n
CONFIG_NVME_AUTH=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

