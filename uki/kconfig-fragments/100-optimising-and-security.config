# Grant full access to /dev/mem -- this is the mechanism we use to write
# directly to physical RAM, so this is important
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
CONFIG_IO_STRICT_DEVMEM=n
CONFIG_LOCK_DOWN_IN_SECURE_BOOT=n

# Always export the SMBios filesystem
CONFIG_DMI_SYSFS=y

# Trust only this build's own autogenerated module-signing key, AKA we don't
# care about Canonical's keys they use for signing stuff we're not using
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# Force modules to have valid signatures tho and prevent modprobing of 
# modules we don't expect to be present in the initramfs, or unloading
# of modules we do expect
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_UNLOAD=n
CONFIG_MODPROBE_PATH=""

# Linux Security Modules have overhead even with no policy loaded. Since
# these modules exist to mediate what userspace processes can do, and we
# won't have any userspace processes, we can just disable them
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_LANDLOCK=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_YAMA=n

# Other things that only used for confining userspace processes that are
# dead weight in this case and just increase memory consumption
CONFIG_AUDIT=n
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_KCMP=n
CONFIG_SCHED_AUTOGROUP=n
CONFIG_CGROUPS=n
CONFIG_SECCOMP=n
CONFIG_NAMESPACES=n

# Prevent the kernel from moving or evicting physical pages from RAM
CONFIG_SWAP=n
CONFIG_ZRAM=n
CONFIG_ZSWAP=n
CONFIG_NUMA_BALANCING=n
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_CMA=n
CONFIG_COMPACTION=n
CONFIG_MIGRATION=n

# No need to support hotplugging for short lived runs of this kernel
CONFIG_MEMORY_HOTPLUG=n
CONFIG_MEMORY_HOTREMOVE=n
CONFIG_HOTPLUG_CPU=n

# Disable the 32bit loader
CONFIG_IA32_EMULATION=n
CONFIG_COMPAT=n

# Uneeded IPC mechanisms
CONFIG_ANDROID_BINDER_IPC=n
CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=n

# Disable unused initramfs compression methods
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# ECC is needed for nvidia drivers
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_ECRDSA=y

# Disable unused crypto compression algorithms
CONFIG_CRYPTO_LZO=n
CONFIG_CRYPTO_842=n
CONFIG_CRYPTO_LZ4=n
CONFIG_CRYPTO_LZ4HC=n
CONFIG_CRYPTO_ZSTD=n
