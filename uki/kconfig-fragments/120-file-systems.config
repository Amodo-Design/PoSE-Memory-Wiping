# Filesystems, we never mount a block device or removable medium

# Linux-native
CONFIG_EXT2_FS=n
CONFIG_EXT3_FS=n
CONFIG_EXT4_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_BCACHEFS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_REISERFS_FS=n

# Other operating systems formats
CONFIG_VFAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_FAT_FS=n
CONFIG_EXFAT_FS=n
CONFIG_NTFS_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_HPFS_FS=n
CONFIG_ADFS_FS=n
CONFIG_AFFS_FS=n
CONFIG_BEFS_FS=n
CONFIG_BFS_FS=n
CONFIG_EFS_FS=n
CONFIG_MINIX_FS=n
CONFIG_OMFS_FS=n
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
CONFIG_SYSV_FS=n
CONFIG_UFS_FS=n
CONFIG_VXFS_FS=n

# Optical and removable media
CONFIG_ISO9660_FS=n
CONFIG_JOLIET=n
CONFIG_ZISOFS=n
CONFIG_UDF_FS=n

# Flash, read-only and image formats
CONFIG_CRAMFS=n
CONFIG_SQUASHFS=n
CONFIG_ROMFS_FS=n
CONFIG_EROFS_FS=n
CONFIG_JFFS2_FS=n
CONFIG_UBIFS_FS=n
CONFIG_ZONEFS_FS=n

# Network and cluster filesystems
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_ORANGEFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_DLM=n

# Stacking, user-space and pseudo filesystems
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n
CONFIG_ECRYPT_FS=n
CONFIG_AUTOFS_FS=n
CONFIG_BINFMT_MISC=n
CONFIG_EFIVAR_FS=n

# Software RAID, and direct-access (persistent memory) mode
CONFIG_MD=n
CONFIG_FS_DAX=n

# Crash-log persistence
# PSTORE itself stays (ACPI_APEI selects it, with MISC_FILESYSTEMS, for the
# ERST error-record backend); the backends that write to RAM, a block device
# or EFI variables go.
CONFIG_PSTORE_RAM=n
CONFIG_PSTORE_ZONE=n
CONFIG_PSTORE_BLK=n
CONFIG_EFI_VARS_PSTORE=n

# Generic VFS features only disk filesystems use
CONFIG_TMPFS_QUOTA=n
CONFIG_QUOTA=n
CONFIG_FANOTIFY=n
CONFIG_FHANDLE=n
CONFIG_EXPORTFS=n
CONFIG_FS_ENCRYPTION=n
CONFIG_FS_VERITY=n
CONFIG_NETFS_SUPPORT=n

# NLS codepage tables
# NLS itself is selected by ACPI and USB, but every table was only ever there
# for FAT, NTFS and ISO9660.
CONFIG_NLS_ASCII=n
CONFIG_NLS_CODEPAGE_437=n
CONFIG_NLS_CODEPAGE_737=n
CONFIG_NLS_CODEPAGE_775=n
CONFIG_NLS_CODEPAGE_850=n
CONFIG_NLS_CODEPAGE_852=n
CONFIG_NLS_CODEPAGE_855=n
CONFIG_NLS_CODEPAGE_857=n
CONFIG_NLS_CODEPAGE_860=n
CONFIG_NLS_CODEPAGE_861=n
CONFIG_NLS_CODEPAGE_862=n
CONFIG_NLS_CODEPAGE_863=n
CONFIG_NLS_CODEPAGE_864=n
CONFIG_NLS_CODEPAGE_865=n
CONFIG_NLS_CODEPAGE_866=n
CONFIG_NLS_CODEPAGE_869=n
CONFIG_NLS_CODEPAGE_874=n
CONFIG_NLS_CODEPAGE_932=n
CONFIG_NLS_CODEPAGE_936=n
CONFIG_NLS_CODEPAGE_949=n
CONFIG_NLS_CODEPAGE_950=n
CONFIG_NLS_CODEPAGE_1250=n
CONFIG_NLS_CODEPAGE_1251=n
CONFIG_NLS_ISO8859_1=n
CONFIG_NLS_ISO8859_2=n
CONFIG_NLS_ISO8859_3=n
CONFIG_NLS_ISO8859_4=n
CONFIG_NLS_ISO8859_5=n
CONFIG_NLS_ISO8859_6=n
CONFIG_NLS_ISO8859_7=n
CONFIG_NLS_ISO8859_8=n
CONFIG_NLS_ISO8859_9=n
CONFIG_NLS_ISO8859_13=n
CONFIG_NLS_ISO8859_14=n
CONFIG_NLS_ISO8859_15=n
CONFIG_NLS_KOI8_R=n
CONFIG_NLS_KOI8_U=n
CONFIG_NLS_MAC_CELTIC=n
CONFIG_NLS_MAC_CENTEURO=n
CONFIG_NLS_MAC_CROATIAN=n
CONFIG_NLS_MAC_CYRILLIC=n
CONFIG_NLS_MAC_GAELIC=n
CONFIG_NLS_MAC_GREEK=n
CONFIG_NLS_MAC_ICELAND=n
CONFIG_NLS_MAC_INUIT=n
CONFIG_NLS_MAC_ROMANIAN=n
CONFIG_NLS_MAC_ROMAN=n
CONFIG_NLS_MAC_TURKISH=n
CONFIG_NLS_UTF8=n
