# Wireless, WAN, and other non-Ethernet transports
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_WWAN=n
CONFIG_WAN=n
CONFIG_ATM=n
CONFIG_ISDN=n
CONFIG_ARCNET=n
CONFIG_PLIP=n
CONFIG_SLIP=n
CONFIG_PPP=n
CONFIG_L2TP=n
CONFIG_IEEE802154=n

# Protocol families other than IPv4 and IPv6
CONFIG_IPV6=y
CONFIG_ATALK=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_LLC2=n
CONFIG_PHONET=n
CONFIG_CAIF=n
CONFIG_AF_RXRPC=n
CONFIG_TIPC=n
CONFIG_RDS=n
CONFIG_IP_DCCP=n
CONFIG_IP_SCTP=n
CONFIG_SMC=n
CONFIG_MPTCP=n
CONFIG_XDP_SOCKETS=n
CONFIG_VSOCKETS=n
CONFIG_QRTR=n
CONFIG_HSR=n
CONFIG_BATMAN_ADV=n
CONFIG_NET_9P=n
CONFIG_MCTP=n
CONFIG_NET_NCSI=n

# Filtering, tunnels, and routing extras
CONFIG_WIREGUARD=n
CONFIG_NET_FOU_IP_TUNNELS=n
CONFIG_NET_FOU=n

# Packet sampling/offloading support
CONFIG_PSAMPLE=y
CONFIG_TLS=y
