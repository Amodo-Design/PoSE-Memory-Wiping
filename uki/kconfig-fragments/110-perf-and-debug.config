# Performance, tracing, and debugging instrumentation

# Profiling and performance counters
CONFIG_PROFILING=n
CONFIG_PERF_EVENTS=n

# Tracing
CONFIG_TRACING=n
CONFIG_FTRACE=n
CONFIG_KGDB=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n

# Hardware trace ports
CONFIG_STM=n
CONFIG_INTEL_TH=n
CONFIG_CORESIGHT=n

# Task accounting and scheduler statistics
CONFIG_LATENCYTOP=n
CONFIG_SCHEDSTATS=n
CONFIG_TASKSTATS=n
CONFIG_TASK_DELAY_ACCT=n
CONFIG_TASK_XACCT=n
CONFIG_TASK_IO_ACCOUNTING=n
CONFIG_PSI=n

# Kexec and crash functions
# (we can't write dumps to disk anyway because no disks will be mounted)
CONFIG_KEXEC_FILE=n
CONFIG_KEXEC=n
CONFIG_COREDUMP=n
CONFIG_CRASH_DUMP=n

# Runtime debugging aids
CONFIG_PUNIT_ATOM_DEBUG=n
CONFIG_NOTIFIER_ERROR_INJECTION=n
CONFIG_FUNCTION_ERROR_INJECTION=n
CONFIG_DEBUG_FS=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_UBSAN=n
CONFIG_KFENCE=n
CONFIG_SLUB_DEBUG=n
CONFIG_DEBUG_MISC=n

# Self-test modules and samples
CONFIG_RUNTIME_TESTING_MENU=n
CONFIG_SAMPLES=n
CONFIG_IKHEADERS=n

# Debug info (build time speed up)
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_BTF_MODULES=n
